{
  "config": {
    "default": true,
    // Line length, duplicate headings, inline HTML, first-line heading:
    "MD013": false,
    "MD024": false,
    "MD033": false,
    "MD041": false,
    // CLAUDE.md deliberately uses a compact style (no blank line between a
    // heading/list and its neighbours, "Heading:" headings, terse tables).
    "MD022": false,
    "MD026": false,
    "MD031": false,
    "MD032": false,
    "MD058": false,
    "MD060": false
  },
  "ignores": ["node_modules"]
}
